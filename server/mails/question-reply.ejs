<html>
  <body style="font-family: Arial, sans-serif; background:#f7f7f7; padding:20px;">
    <div style="max-width:600px; margin:auto; background:white; padding:25px; border-radius:12px; box-shadow:0 0 10px rgba(0,0,0,0.1);">
      <h2 style="color:#333;">Your Question Has Been Answered</h2>

      <p style="font-size:16px; color:#555;">Hello <strong><%= name %></strong>,</p>

      <p style="font-size:15px; color:#444; line-height:1.5;">
        The admin has replied to your question related to: <strong><%= title %></strong>.
      </p>

      <div style="margin-top:20px; padding:15px; background:#f0f0f0; border-left:4px solid #007bff; border-radius:8px;">
        <p style="margin:0; font-size:15px; color:#333;">You can visit your account to view the full reply.</p>
      </div>

      <p style="margin-top:25px; font-size:14px; color:#777;">Thank you for using our platform!</p>
    </div>
  </body>
</html>
