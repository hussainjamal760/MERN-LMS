<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>SheepAcademy Activation Code</title>
  <style>
    body { font-family: Arial, sans-serif; background:#f6f7fb; margin:0; padding:0; }
    .card { max-width:600px; margin:28px auto; background:#ffffff; border-radius:8px; padding:24px; box-shadow:0 6px 20px rgba(0,0,0,0.06); }
    .logo { text-align:center; margin-bottom:16px; }
    .h1 { font-size:20px; margin:0 0 8px; color:#222; }
    .lead { color:#555; margin-bottom:20px; }
    .pin { display:inline-block; font-size:28px; letter-spacing:6px; background:#f2f4f8; padding:12px 18px; border-radius:8px; margin:12px 0; }
    .note { color:#888; font-size:13px; margin-top:12px; }
    .cta { display:inline-block; margin-top:18px; text-decoration:none; padding:10px 16px; border-radius:6px; background:#2563eb; color:white; font-weight:600; }
    .footer { color:#999; font-size:12px; margin-top:20px; text-align:center; }
  </style>
</head>
<body>
  <div class="card">

    <p class="h1">Hello <%= user.name %> from SheepAcademy</p>

    <p class="lead">Your activation PIN for is below. Use it to verify your account.</p>

    <div class="pin"><%= activationCode %></div>

    <p class="note">This PIN expires in <strong>5 minutes</strong>. If you did not request this, ignore this message.</p>

    <p class="footer">
      Need help? Contact us at <a href="mailto:hjamal9865@gmail.com">support@example.com</a> %>
    </p>
  </div>
</body>
</html>
